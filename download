    /* ──────────────────────── TONE RULES ─────────────────────────── */

    private function tone_rules( $tone ) {
        switch ( $tone ) {
            case 'basic':
                return "TONE: Simple and direct. Short sentences. No jargon. Answer the question plainly. No filler words.\n";
            case 'casual':
                return "TONE: Friendly and warm, like chatting with a knowledgeable colleague. Use contractions. Show personality. Invite further conversation naturally.\n";
            case 'sandor':
                return "TONE: 'Building in Public' style. Honest, technical but accessible. The narrative is an autodidact and university student finding their way into automation and AI product design. State facts and progress, no fluff, no overselling, no cringe. If something is in progress, say so. Sound like a real person documenting their journey. Always end with a natural pointer: where to find out more, what to look at next, or what to ask.\n";
            case 'professional':
            default:
                return "TONE: Polished UK professional with subtle wit. Confident but approachable. Focus on impact and expertise. Ask a natural follow-up when appropriate.\n";
        }
    }

    /* ───────────────────────── SMART CTA ────────────────────────── */

    private function get_cta( $query ) {
        $name  = get_option( 'cv_chatbot_name', '' );
        $q     = strtolower( $query );
        $items = array(); // collect multiple CTA items, render as a group

        $L = array(
            'cv'        => get_option( 'cv_chatbot_cv_url',     '' ),
            'portfolio' => get_option( 'cv_chatbot_portfolio',  '' ),
            'blog'      => get_option( 'cv_chatbot_blog',       '' ),
            'github'    => get_option( 'cv_chatbot_github',     '' ),
            'linkedin'  => get_option( 'cv_chatbot_linkedin',   '' ),
            'email'     => get_option( 'cv_chatbot_email',      '' ),
            'phone'     => get_option( 'cv_chatbot_phone',      '' ),
            'linktree'  => get_option( 'cv_chatbot_linktree',   '' ),
            'twitter'   => get_option( 'cv_chatbot_twitter',    '' ),
            'behance'   => get_option( 'cv_chatbot_behance',    '' ),
            'youtube'   => get_option( 'cv_chatbot_youtube',    '' ),
            'instagram' => get_option( 'cv_chatbot_instagram',  '' ),
        );

        // ── CV download ──────────────────────────────────────────────
        if ( $this->match( $q, array( 'cv', 'resume', 'download', 'pdf', 'curriculum' ) ) ) {
            if ( $L['cv'] )       $items[] = $this->cta_link( $L['cv'], 'Download CV (PDF) ↓', true );
            if ( $L['linkedin'] ) $items[] = $this->cta_link( $L['linkedin'], 'View LinkedIn profile →' );
        }

        // ── Design / portfolio ───────────────────────────────────────
        if ( $this->match( $q, array( 'design', 'portfolio', 'creative', 'brand', 'visual', 'ui', 'ux', 'figma', 'graphic' ) ) ) {
            if ( $L['behance'] )   $items[] = $this->cta_link( $L['behance'],   'Design portfolio on Behance →' );
            if ( $L['portfolio'] ) $items[] = $this->cta_link( $L['portfolio'], 'Visit portfolio website →' );
        }

        // ── Blog / writing / updates ─────────────────────────────────
        if ( $this->match( $q, array( 'blog', 'post', 'article', 'writing', 'update', 'latest', 'recent', 'news', 'building in public' ) ) ) {
            if ( $L['blog'] ) $items[] = $this->cta_link( $L['blog'], 'Read the blog →' );
        }

        // ── Code / projects ──────────────────────────────────────────
        if ( $this->match( $q, array( 'code', 'develop', 'github', 'project', 'python', 'javascript', 'plugin', 'automation', 'n8n', 'mvp', 'build' ) ) ) {
            if ( $L['github'] )    $items[] = $this->cta_link( $L['github'], 'View projects on GitHub →' );
            if ( $L['portfolio'] ) $items[] = $this->cta_link( $L['portfolio'], 'See live projects →' );
        }

        // ── Contact / hire ───────────────────────────────────────────
        if ( $this->match( $q, array( 'contact', 'email', 'hire', 'available', 'work together', 'freelance', 'reach', 'get in touch', 'phone', 'call', 'message', 'intern', 'internship', 'apprentice', 'apprenticeship', 'opportunity', 'job', 'role', 'position', 'collaborate', 'open to work', 'frequently', 'kapcsolat', 'felvesz', 'állás', 'munka', 'együttműködés' ) ) ) {
            if ( $L['email'] ) $items[] = '<a href="mailto:' . esc_attr( $L['email'] ) . '">' . esc_html( $L['email'] ) . ' ✉</a>';
            if ( $L['phone'] ) $items[] = '<a href="tel:' . esc_attr( preg_replace( '/\s+/', '', $L['phone'] ) ) . '">' . esc_html( $L['phone'] ) . ' 📞</a>';
            if ( $L['cv'] )    $items[] = $this->cta_link( $L['cv'], 'Download CV (PDF) ↓', true );
            if ( $L['linkedin'] ) $items[] = $this->cta_link( $L['linkedin'], 'Connect on LinkedIn →' );
        }

        // ── LinkedIn specifically ────────────────────────────────────
        if ( $this->match( $q, array( 'linkedin', 'connect', 'network', 'professional profile' ) ) ) {
            if ( $L['linkedin'] ) $items[] = $this->cta_link( $L['linkedin'], 'Connect on LinkedIn →' );
        }

        // ── YouTube / video / content ────────────────────────────────
        if ( $this->match( $q, array( 'video', 'youtube', 'channel', 'watch', 'content' ) ) ) {
            if ( $L['youtube'] ) $items[] = $this->cta_link( $L['youtube'], 'Watch on YouTube →' );
        }

        // ── Education / Napier / uni ─────────────────────────────────
        if ( $this->match( $q, array( 'education', 'university', 'degree', 'napier', 'study', 'course', 'college', 'qualification' ) ) ) {
            if ( $L['linkedin'] ) $items[] = $this->cta_link( $L['linkedin'], 'Full background on LinkedIn →' );
            if ( $L['cv'] )       $items[] = $this->cta_link( $L['cv'], 'Download CV →', true );
        }

        // ── Skills ───────────────────────────────────────────────────
        if ( $this->match( $q, array( 'skill', 'stack', 'tech', 'tool', 'experience', 'know', 'use', 'infrastructure' ) ) ) {
            if ( $L['portfolio'] ) $items[] = $this->cta_link( $L['portfolio'] . 'stack/', 'View tech stack →' );
            if ( $L['github'] )    $items[] = $this->cta_link( $L['github'], 'See it in code on GitHub →' );
        }

        // Deduplicate
        $items = array_unique( $items );

        if ( ! empty( $items ) ) {
            return implode( '<span class="cv-cta-sep"> &nbsp;·&nbsp; </span>', $items );
        }

        // ── Default fallback ─────────────────────────────────────────
        if ( $L['linktree'] )  return $this->cta_link( $L['linktree'],  'All links →' );
        if ( $L['linkedin'] )  return $this->cta_link( $L['linkedin'],  'Connect on LinkedIn →' );
        if ( $L['portfolio'] ) return $this->cta_link( $L['portfolio'], 'Visit website →' );

        return '';
    }

    private function cta_link( $url, $label, $download = false ) {
        $dl = $download ? ' download' : '';
        return '<a href="' . esc_url( $url ) . '" target="_blank" rel="noopener noreferrer"' . $dl . '>' . esc_html( $label ) . '</a>';
    }

    private function match( $text, $keywords ) {
        foreach ( $keywords as $kw ) {
            if ( strpos( $text, $kw ) !== false ) return true;
        }
        return false;
    }

