    /* ──────────────────── CV PARSE (AJAX) ────────────────────────── */

    public function handle_cv_parse() {
        if ( ! current_user_can( 'manage_options' ) ) {
            wp_send_json_error( 'Unauthorised.' );
        }
        if ( ! isset( $_POST['nonce'] ) || ! wp_verify_nonce( $_POST['nonce'], 'cv_chatbot_admin_nonce' ) ) {
            wp_send_json_error( 'Security check failed.' );
        }

        $raw = isset( $_POST['cv_text'] ) ? wp_strip_all_tags( $_POST['cv_text'] ) : '';
        if ( empty( $raw ) ) {
            wp_send_json_error( 'No CV text received.' );
        }

        $api_key = get_option( 'cv_chatbot_api_key' );
        if ( empty( $api_key ) ) {
            wp_send_json_error( 'Add your Gemini API key first.' );
        }

        $prompt = "Convert the following raw CV text into a clean, well-structured plain-text format optimised for an AI assistant to answer questions about the person. Use clear section headings (e.g. PROFESSIONAL SUMMARY, SKILLS, EXPERIENCE, EDUCATION, PROJECTS). Remove HTML entities, fix formatting, expand abbreviations where obvious. Output plain text only, no markdown, no JSON.\n\nRAW CV:\n{$raw}";

        $payload = array(
            'contents' => array(
                array( 'role' => 'user', 'parts' => array( array( 'text' => $prompt ) ) ),
            ),
            'generationConfig' => array( 'temperature' => 0.2, 'maxOutputTokens' => 2000 ),
        );

        $url  = "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={$api_key}";
        $resp = wp_remote_post( $url, array(
            'body'    => wp_json_encode( $payload ),
            'headers' => array( 'Content-Type' => 'application/json' ),
            'timeout' => 45,
        ) );

        if ( is_wp_error( $resp ) || wp_remote_retrieve_response_code( $resp ) !== 200 ) {
            wp_send_json_error( 'Could not parse CV. Check API key or try again.' );
        }

        $data   = json_decode( wp_remote_retrieve_body( $resp ), true );
        $parsed = isset( $data['candidates'][0]['content']['parts'][0]['text'] )
            ? $data['candidates'][0]['content']['parts'][0]['text']
            : null;

        if ( ! $parsed ) {
            wp_send_json_error( 'AI returned an empty response. Try again.' );
        }

        wp_send_json_success( array( 'parsed' => trim( $parsed ) ) );
    }
